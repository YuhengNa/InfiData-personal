{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfiData Long-Term Memory Segment Schema",
  "type": "object",
  "required": [
    "episode_index",
    "segment_index",
    "start_frame",
    "end_frame",
    "task",
    "summary",
    "annotation_status"
  ],
  "properties": {
    "episode_index": { "type": "integer" },
    "segment_index": { "type": "integer" },
    "start_frame": { "type": "integer" },
    "end_frame": { "type": "integer" },
    "start_timestamp": { "type": "number" },
    "end_timestamp": { "type": "number" },
    "task": { "type": "string" },
    "prompt": { "type": "string" },
    "summary": { "type": "string" },
    "change_event_type": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_start_frame": { "type": "integer" },
    "evidence_end_frame": { "type": "integer" },
    "annotation_status": {
      "type": "string",
      "enum": ["auto", "vlm_pseudo", "human_labeled", "human_verified", "reviewed", "approved"]
    },
    "annotator": { "type": "string" },
    "reviewer": { "type": "string" }
  }
}
